# Example configuration for local development. Every value is a local,
# non-secret default; docker-compose.yml already applies them, so copying this
# file to .env is only needed to change them or to run the service on the host.

# --- docker compose: dependencies and published ports ---
POSTGRES_PASSWORD=wallet_owner_local
WALLET_APP_DB_PASSWORD=wallet_app_local
KEYCLOAK_ADMIN_PASSWORD=admin
POSTGRES_HOST_PORT=55432
KEYCLOAK_HOST_PORT=8180
MINISTACK_HOST_PORT=4566

# --- service (cmd/wallet), shown with the values used to run it on the host ---
INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
START_TIMEOUT=60s
SHUTDOWN_TIMEOUT=25s

# Restricted application role; never the schema owner.
DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:55432/wallet?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_LOCK_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30s

# Tokens must carry this issuer and audience; keys come from the JWKS URL.
OIDC_ISSUER=http://localhost:8180/realms/wallet
OIDC_JWKS_URL=http://localhost:8180/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

# SQS through MiniStack. Credentials come from the standard AWS chain; the
# provisioning script writes them to the sqs-credentials volume, e.g.:
#   docker compose exec ministack cat /shared/aws/credentials > .aws-credentials
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SHARED_CREDENTIALS_FILE=./.aws-credentials
AWS_PROFILE=wallet-service
SQS_INBOUND_QUEUE=wager-transactions.fifo
SQS_DEAD_LETTER_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo

CONSUMER_ENABLED=true
CONSUMER_NAME=wallet-service.wager-transactions
CONSUMER_CONCURRENCY=8
CONSUMER_WAIT_TIME=10s
CONSUMER_PROCESSING_TIMEOUT=10s
CONSUMER_RETRY_BASE_DELAY=2s
CONSUMER_RETRY_MAX_DELAY=60s

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m

REFERENCE_WORKER_ENABLED=true
REFERENCE_POLL_INTERVAL=500ms
REFERENCE_RETRY_BASE_DELAY=1s
REFERENCE_RETRY_MAX_DELAY=30s
REFERENCE_MAX_ATTEMPTS=12

# --- migrations (cmd/migrate), as the schema owner ---
MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner_local@localhost:55432/wallet?sslmode=disable
